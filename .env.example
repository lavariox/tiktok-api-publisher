# Copiar a .env y completar. NUNCA subir .env al repo.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8723/callback
# SELF_ONLY hasta pasar la auditoria de TikTok; despues PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY
# Opcional: open_id de la cuenta cuando hay varias autorizadas
# TIKTOK_OPEN_ID=
